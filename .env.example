# ================================
# Madina Solution Environment
# ================================

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Authentication
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Public site
NEXT_PUBLIC_SITE_URL=https://madinasolution.web.app

# Payment provider: mock (development only), midtrans, or xendit
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=

# Transactional email: console (development only) or resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Madina Solution <noreply@example.com>

# Production media storage (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Environment is supplied automatically by Next.js/Vercel.
# Do not commit real credentials to Git.
